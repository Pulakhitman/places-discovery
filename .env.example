# App
DOMAIN=places.localhost

# Nominatim (OpenStreetMap geocoding)
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=PlacesDiscovery/0.1 (local-dev)
NOMINATIM_TIMEOUT_MS=10000

# Overpass (OSM discovery) — used in later steps
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_MS=60000
OVERPASS_USER_AGENT=PlacesDiscovery/0.1 (local-dev)

# Google Places / Maps (official APIs only — no scraping)
# Server key for Places API (New): Nearby/Text Search, Place Details
# Enable "Places API (New)" on the Google Cloud project for this key.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_TIMEOUT_MS=15000
# Optional browser key for Maps JavaScript API in the same map container
# Restrict by HTTP referrer in Google Cloud. Never put the server Places key here.
GOOGLE_MAPS_BROWSER_KEY=
# Soft daily USD estimate for the in-app usage panel (UTC day, this process only)
GOOGLE_PLACES_DAILY_BUDGET_USD=

# Foursquare Places API (official). Server-side service key only.
# Pro match and Premium details are separate on-demand calls; Premium is billed.
FOURSQUARE_SERVICE_KEY=

# BestTime foot traffic (official). Server-side keys only; never NEXT_PUBLIC_*.
# Private key (pri_…) enables forecast creation and live requests: separate,
# explicitly triggered paid calls. Preferred name below. The legacy name
# BESTPLACES_API_KEY is read only when this is empty and its value starts with pri_.
BESTTIME_PRIVATE_API_KEY=
# Optional public key (pub_…): read-only, shown as setup status only. Never sent to
# BestTime and cannot create forecasts. A pub_ BESTPLACES_API_KEY counts here instead.
BESTTIME_PUBLIC_API_KEY=

# Overture regional SQLite snapshot (see docs/overture.md). Import separately,
# then mount the host directory read-only in docker-compose.yml.
OVERTURE_DATA_DIR=./data/overture
OVERTURE_DB_PATH=/data/overture/places.sqlite

# Traefik (Docker Compose)
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Optional shared access key (single string). When set, UI + APIs require unlock.
# Leave empty for local/dev convenience (no gate). /api/health stays public.
# Never use NEXT_PUBLIC_* for this — server-side only.
ACCESS_KEY=
