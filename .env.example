# App
DOMAIN=places.localhost

# Nominatim (OpenStreetMap geocoding)
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=PlacesDiscovery/0.1 (local-dev)
NOMINATIM_TIMEOUT_MS=10000

# Overpass (OSM discovery) — used in later steps
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_MS=60000
OVERPASS_USER_AGENT=PlacesDiscovery/0.1 (local-dev)

# Google Places / Maps (official APIs only — no scraping)
# Server key for Places API (New): Nearby/Text Search, Place Details, Photos
# Enable "Places API (New)" on the Google Cloud project for this key.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_TIMEOUT_MS=15000
# In-memory Place Details cache TTL (ms). 0 disables.
GOOGLE_PLACES_DETAILS_CACHE_TTL_MS=900000
# Optional browser key for Maps JavaScript API in the same map container
# Restrict by HTTP referrer in Google Cloud. Never put the server Places key here.
GOOGLE_MAPS_BROWSER_KEY=
# Soft daily USD estimate for the in-app usage panel (UTC day, this process only)
GOOGLE_PLACES_DAILY_BUDGET_USD=

# Traefik (Docker Compose)
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Optional Basic Auth (set both or neither). /api/health stays public.
AUTH_USER=
AUTH_PASSWORD=
